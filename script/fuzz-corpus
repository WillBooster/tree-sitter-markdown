#!/usr/bin/env bash

# Runs `tree-sitter fuzz` on the corpus of the given grammar directory (`tree-sitter-markdown` or
# `tree-sitter-markdown-inline`): it edits each corpus case at random, reparses it incrementally, undoes the edits, and
# reparses again.

set -euo pipefail

cd "$(dirname "$0")/.."
grammar=$1
name=$(node -e 'console.log(require(`./${process.argv[1]}/src/grammar.json`).name)' "$grammar")

mkdir -p .tmp/fuzz
# Runs in the same checkout may overlap, so each builds the parser into a file of its own. The path is absolute because
# the fuzzer, and so the trap, runs in the grammar directory.
parser=$(mktemp "$PWD/.tmp/fuzz/$name.XXXXXX")
trap 'rm -f "$parser"' EXIT
script/tree-sitter build -o "$parser" "$grammar"

export TREE_SITTER_SEED=${TREE_SITTER_SEED:-1}
export TREE_SITTER_ITERATIONS=${TREE_SITTER_ITERATIONS:-1000}
export TREE_SITTER_EDITS=${TREE_SITTER_EDITS:-10}
excluded=$(script/corpus-exclusions "$grammar")
cd "$grammar"
../script/tree-sitter fuzz --lib-path "$parser" --lang-name "$name" --exclude "$excluded"
