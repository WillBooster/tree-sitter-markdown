#!/usr/bin/env bash

# Parses real-world Markdown files cloned into examples/ with the block grammar and rewrites script/known-failures.txt, the list of
# files that fail to parse. With --check, fails instead when that list would change.

set -euo pipefail

check=false
if [[ ${1-} == --check ]]; then
  check=true
fi

# Each example repository is pinned to a commit so that the list of failures changes only with the grammar.
# Moving a pin requires running this script without --check to update the list. The checkouts under
# examples/ belong to this script: local changes there are discarded so that the pinned files are parsed.
# The hosts occasionally answer with a server error, so each fetch is retried in place.
clone() {
  local dir=examples/$1
  if [[ $(git -C "$dir" rev-parse HEAD 2> /dev/null) != "$3" ]]; then
    if [[ ! -d $dir/.git ]]; then
      rm -rf "$dir"
      git init -q "$dir"
    fi
    local attempt
    for attempt in 1 2 3 4; do
      if git -C "$dir" fetch -q --depth=1 "$2" "$3"; then
        break
      fi
      if [[ $attempt == 4 ]]; then
        return 1
      fi
      sleep $((attempt * 15))
    done
    git -C "$dir" checkout -q -f --detach "$3"
  fi
  git -C "$dir" reset -q --hard
  git -C "$dir" clean -q -ffdx
}

cd "$(dirname "$0")/.."
clone book https://github.com/rust-lang/book 05d114287b7d6f6c9253d5242540f00fbd6172ab
clone content https://github.com/mdn/content 887d5abd234d91b020daf91838ec63d5328e1fcc

files=$(mktemp)
output=$(mktemp)
failures=$(mktemp)
mkdir -p .tmp/parse-examples
# Runs in the same checkout may overlap, so each builds the parser into a file of its own.
parser=$(mktemp .tmp/parse-examples/markdown.XXXXXX)
trap 'rm -f "$files" "$output" "$failures" "$parser"' EXIT

find examples -type f -name '*.md' -print | LC_ALL=C sort > "$files"

# The block grammar parses whole files; the inline grammar parses only the inline content that the block grammar finds.
script/tree-sitter build -o "$parser" tree-sitter-markdown

# The CLI exits non-zero whenever a file fails, so the output decides success. `--time` makes it print
# a line for each file, including files that exceed `--timeout` (30 s), which bounds a runaway parse.
script/tree-sitter parse --lib-path "$parser" --lang-name markdown -q -s --time --timeout 30000000 \
  --paths "$files" > "$output" || true
if ! grep -q '^Total parses' "$output"; then
  cat "$output" >&2
  exit 1
fi
grep '^Total parses' "$output"
# With an empty known-failures.txt, a run that parses no file would pass, so every file found must have been parsed.
total=$(sed -n 's/^Total parses: \([0-9]*\);.*/\1/p' "$output")
expected=$(grep -c . "$files" || true)
if [[ $expected == 0 || $total != "$expected" ]]; then
  echo "Parsed $total of $expected example files" >&2
  exit 1
fi
# A timeout depends on the machine, so it is no expected failure.
if grep -q 'timed out' "$output"; then
  echo 'These files exceeded the parse timeout; known-failures.txt is left unchanged:' >&2
  awk '/timed out/{print $1}' "$output" >&2
  exit 1
fi
awk '/ERROR|MISSING/{print $1}' "$output" | LC_ALL=C sort > "$failures"
if [[ $check == true ]]; then
  if ! diff -u script/known-failures.txt "$failures" >&2; then
    echo 'The files failing to parse differ from script/known-failures.txt (- fixed, + broken).' >&2
    echo 'Run script/parse-examples to update the list after checking the diff.' >&2
    exit 1
  fi
else
  cp "$failures" script/known-failures.txt
fi
