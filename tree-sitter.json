{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "markdown",
      "camelcase": "Markdown",
      "scope": "text.markdown",
      "path": "tree-sitter-markdown",
      "external-files": ["common/common.js"],
      "file-types": ["md"],
      "injection-regex": "^(markdown|md)$"
    },
    {
      "name": "markdown_inline",
      "camelcase": "MarkdownInline",
      "scope": "text.markdown_inline",
      "path": "tree-sitter-markdown-inline",
      "external-files": ["common/common.js"],
      "file-types": null
    }
  ],
  "metadata": {
    "version": "0.5.3",
    "license": "MIT",
    "description": "Markdown grammar for tree-sitter",
    "authors": [
      {
        "name": "WillBooster Inc."
      }
    ],
    "links": {
      "repository": "https://github.com/WillBooster/tree-sitter-markdown"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
